# ---------------------------------------------------------------------------
# Contact form email delivery (Brevo)
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, and set the same four variables in
# Vercel under Settings > Environment Variables for Preview and Production.
#
# With these unset, the contact form still validates and accepts submissions in
# development (the payload is logged to the server console) but returns an
# error in production rather than silently dropping a lead.

# Brevo API key: dashboard > SMTP & API > API Keys. Starts with "xkeysib-".
BREVO_API_KEY=

# Sender ("from") address. Must be a verified sender or sit on a domain
# authenticated in Brevo (dashboard > Senders, Domains & Dedicated IPs),
# otherwise Brevo rejects the send with a 400 and the form returns an error.
# photonmatters.com is authenticated, so any address on it works.
BREVO_SENDER_EMAIL=hello@photonmatters.com

# Optional. Display name on outbound email. Defaults to "PhotonMatters".
BREVO_SENDER_NAME=PhotonMatters

# Internal inbox that receives contact-form notifications. Recipients need no
# Brevo verification. Accepts a comma-separated list, e.g.
# "hello@photonmatters.com,sales@photonmatters.com".
CONTACT_TO=hello@photonmatters.com
